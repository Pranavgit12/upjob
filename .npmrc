# npm 11+ blocks lifecycle scripts from transitive dependencies by default.
# UpJob's Prisma engine binaries and native modules are installed via those
# scripts, so without this a fresh `npm ci` produces a container whose Prisma
# client cannot generate or connect.
allow-scripts[]=@prisma/engines
allow-scripts[]=prisma
allow-scripts[]=unrs-resolver
allow-scripts[]=sharp
