# UpJob environment variables
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env
#   # generate a secret:  openssl rand -base64 48
#
# Only `NEXT_PUBLIC_*` values are inlined into the browser bundle at BUILD time.
# Everything else is read from the container/host environment at RUNTIME.

# --------------------------------------------------------------------------
# Database (required)
# --------------------------------------------------------------------------
# A long-lived server connection should use the TRANSACTION pooler
# (Supabase: port 6543), not the session pooler. The session pooler holds
# connections open for the life of each `pg` pool and will exhaust its limit
# under load — this caused P2034/EMAXCONNSESSION failures during `next build`.
#
# For `docker compose up`, this value is IGNORED: Compose builds the app's
# DATABASE_URL from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB and points it at
# the `db` service, because `localhost` inside a container is the app itself.
# Set DATABASE_URL here only for non-Docker deployments (`npm run dev`, systemd,
# a managed database). Use DATABASE_URL_SSL_PARAM below to tune Compose instead.
DATABASE_URL="postgresql://user:password@localhost:5432/upjob?schema=public"
# Query string appended to the DATABASE_URL Compose generates. For a managed or
# TLS-terminated database, e.g. "?schema=public&sslmode=require".
DATABASE_URL_SSL_PARAM="?schema=public"
# Only used by docker-compose's bundled Postgres service.
POSTGRES_USER="upjob"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="upjob"

# --------------------------------------------------------------------------
# Auth (required in production)
# --------------------------------------------------------------------------
# Must be >= 32 characters or the app refuses to start when NODE_ENV=production.
# Rotating this signs out every user and invalidates all password-reset links.
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Login-time second factor. Controls who gets challenged for a one-time code.
#   required  (default) every non-admin login is challenged
#   optional            only users who opted in via User.mfaEnabled
#   off                 never challenge
# Admins are always exempt so a broken mail transport cannot lock you out of
# the admin panel.
OTP_MODE="required"

# Google OAuth (login with Google): https://console.cloud.google.com/apis/credentials
# Add these Authorized redirect URIs to your OAuth 2.0 Client ID:
#   http://localhost:3000/api/auth/google/callback (dev)
#   https://your-domain.com/api/auth/google/callback (prod)
# Must have "openid profile email" scopes on the OAuth consent screen.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------------------------------------
# App
# --------------------------------------------------------------------------
# Public origin, no trailing slash. Used for OAuth redirects, reset links and
# email links — a wrong value here silently breaks password reset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Host port for docker-compose.
APP_PORT="3000"

# --------------------------------------------------------------------------
# Email — Resend (required for OTP delivery)
# --------------------------------------------------------------------------
# https://resend.com/domains — verify your domain, then set the from address.
# Without a key the Email carrier is hidden and, in production, login fails with
# HTTP 503 rather than reporting a code that was never delivered. In development
# the email is only written to the server log, which is fine for local testing.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="UpJob <no-reply@yourdomain.com>"

# --------------------------------------------------------------------------
# SMS carrier (optional — enables the "Text message" OTP carrier)
# --------------------------------------------------------------------------
# Speaks the Twilio Messages REST shape; works with Twilio, MessageBird and
# most gateways. `SMS_API_BASE_URL` overrides the host.
# The carrier only appears in the picker when all three are set AND the user has
# a phone number on their profile.
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_FROM=""
SMS_API_BASE_URL="https://api.twilio.com/2010-04-01"

# --------------------------------------------------------------------------
# Storage (S3-compatible: Cloudflare R2 / Backblaze B2 / AWS S3 / MinIO)
# Required for CV uploads and interview recordings.
#   Cloudflare R2 (free egress):  https://<account-id>.r2.cloudflarestorage.com
#   Backblaze B2:                https://s3.us-east-005.backblazeb2.com
#   AWS S3:                      https://s3.amazonaws.com
#   MinIO (local dev):           http://localhost:9000
S3_ENDPOINT=""
S3_BUCKET="upjob-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"
# Public URL for direct browser access (optional — leave empty to proxy via API).
UPLOADS_PUBLIC_URL=""

# --------------------------------------------------------------------------
# Uploads
# --------------------------------------------------------------------------
# Server-side upload ceiling in MB. `NEXT_PUBLIC_MAX_CV_SIZE_MB` must match, or
# the browser will accept files the server rejects. Setting either one is
# enough — they resolve to a single shared limit.
MAX_CV_SIZE_MB="10"
NEXT_PUBLIC_MAX_CV_SIZE_MB="10"

# --------------------------------------------------------------------------
# AI — Google Gemini
# --------------------------------------------------------------------------
# Without a key the AI interview feature silently no-ops.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# --------------------------------------------------------------------------
# Seed (required only to run `npm run db:seed`)
# --------------------------------------------------------------------------
# Both must be set and ADMIN_PASSWORD must be >= 12 chars, or the seed aborts.
# Generate with: openssl rand -base64 24
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
